<mxfile host="app.diagrams.net"><diagram id="lab5" name="Загрузка страницы сериала"><mxGraphModel grid="0" page="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="start" value="Открытие страницы или повтор" style="whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=25;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;ellipse;" vertex="1" parent="1"><mxGeometry x="280" y="20" width="300" height="80" as="geometry" /></mxCell><mxCell id="loading" value="Показать индикатор загрузки" style="whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=25;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="280" y="140" width="300" height="90" as="geometry" /></mxCell><mxCell id="request" value="Проверить номер и получить сведения о сериале" style="whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=25;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;shape=process;" vertex="1" parent="1"><mxGeometry x="280" y="280" width="300" height="120" as="geometry" /></mxCell><mxCell id="ok" value="Данные получены?" style="whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=25;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;rhombus;" vertex="1" parent="1"><mxGeometry x="290" y="460" width="280" height="120" as="geometry" /></mxCell><mxCell id="success" value="Показать описание и число сезонов" style="whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=25;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;shape=parallelogram;spacingLeft=50;spacingRight=50;fontSize=22;" vertex="1" parent="1"><mxGeometry x="20" y="680" width="300" height="110" as="geometry" /></mxCell><mxCell id="missing" value="Сериал отсутствует?" style="whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=25;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;rhombus;" vertex="1" parent="1"><mxGeometry x="650" y="680" width="280" height="120" as="geometry" /></mxCell><mxCell id="notfound" value="Пока